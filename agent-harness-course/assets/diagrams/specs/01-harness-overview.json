  "cards": [
    {
      "dot": "cyan",
      "title": "三层边界",
      "items": [
        "Core Runtime（pi-agent-core + pi-ai）完全不知道「编码」这件事",
        "产品层 pi-coding-agent 负责组装：会话、工具、提示词、UI"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么 LLM 不是 Agent",
      "items": [
        "LLM 只做一件事：收 Context，吐 token，请求结束即失忆",
        "它不能执行工具、不能持久化、看不到文件系统"
      ]
    },
    {
      "dot": "emerald",
      "title": "读图顺序",
      "items": [
        "主路径：用户 → TUI → AgentSession → agentLoop",
        "工具路径：agentLoop → Registry → Executor → OS"
      ]
    }
  ]
